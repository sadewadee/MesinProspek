# Settings of the local stack (deploy/docker-compose.local.yml). Dummy values for a laptop only; never
# reuse them on a server (STD-AGENT-06). The stack reads this file, then deploy/.env.local (git-ignored,
# optional) for your own overrides. Keys of the server stacks: docs/06 §7.

MSP_ENV=local
MSP_LOG_LEVEL=debug

# Postgres superuser, used by the first init of an empty volume only. Integration tests on the host use it:
#   MSP_TEST_DATABASE_URL='postgres://postgres:local-postgres@localhost:5432/postgres?sslmode=disable' make test
POSTGRES_PASSWORD=local-postgres

# Runtime role msp_app (api, worker) and schema owner msp_owner (`msp migrate` only), apps/api/db/roles.sql.
# The first init (postgres/init-msp.sh) sets both passwords from these URLs.
MSP_DATABASE_URL=postgres://msp_app:local-msp-app@postgres:5432/msp?sslmode=disable
MSP_MIGRATE_DATABASE_URL=postgres://msp_owner:local-msp-owner@postgres:5432/msp?sslmode=disable
