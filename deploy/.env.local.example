# Settings of the local stack (deploy/docker-compose.local.yml), with the keys of deploy/.env.example that
# the local stack needs. Dummy values for a laptop only; never reuse them on a server (STD-AGENT-06).
# The stack reads this file, then deploy/.env.local (git-ignored, optional) for your own overrides.

MSP_ENV=local
MSP_LOG_LEVEL=debug
# Origin of the app (Caddyfile.local): state-changing API requests must come from it (docs/04 §9).
MSP_PUBLIC_URL=http://localhost:8000
# Kratos public API inside the network: api asks it who a session is, web reads the flows.
MSP_KRATOS_PUBLIC_URL=http://kratos:4433

# Postgres superuser, used by the first init of an empty volume only. Integration tests on the host use it:
#   MSP_TEST_DATABASE_URL='postgres://postgres:local-postgres@localhost:5432/postgres?sslmode=disable' make test
POSTGRES_PASSWORD=local-postgres

# Runtime role msp_app (api, worker) and schema owner msp_owner (`msp migrate` only), apps/api/db/roles.sql.
# The first init (postgres/init-msp.sh) sets both passwords from these URLs.
MSP_DATABASE_URL=postgres://msp_app:local-msp-app@postgres:5432/msp?sslmode=disable
MSP_MIGRATE_DATABASE_URL=postgres://msp_owner:local-msp-owner@postgres:5432/msp?sslmode=disable

# Kratos (deploy/kratos/kratos.yml says what each key does). The first init creates role and database
# kratos with the password of DSN.
DSN=postgres://kratos:local-kratos@postgres:5432/kratos?sslmode=disable&max_conns=20&max_idle_conns=4
# = MSP_PUBLIC_URL + /.ory/; the server stacks derive it from MSP_PUBLIC_URL in Compose.
SERVE_PUBLIC_BASE_URL=http://localhost:8000/.ory/
SECRETS_COOKIE=local-cookie-secret-not-for-servers
# Exactly 32 characters.
SECRETS_CIPHER=local-cipher-secret-32-chars-xyz
COURIER_SMTP_CONNECTION_URI=smtp://mailpit:1025/?disable_starttls=true
COURIER_SMTP_FROM_ADDRESS=no-reply@mesinprospek.local
# Google login is off. To try it, put these two lines in .env.local with a Google OAuth client whose
# redirect URI is http://localhost:8000/.ory/self-service/methods/oidc/callback/google:
#   SELFSERVICE_METHODS_OIDC_ENABLED=true
#   SELFSERVICE_METHODS_OIDC_CONFIG_PROVIDERS='[{"id":"google","provider":"google","client_id":"<id>","client_secret":"<secret>","mapper_url":"file:///etc/kratos/oidc.google.jsonnet","scope":["email","profile"]}]'
