# /opt/ops/.env: settings and secrets of the ops stack (docs/06-ci-cd.md §7).
# Copy to /opt/ops/.env and replace every CHANGE_ME. Keep a copy in the founder's
# password manager. Never commit the filled file.
# Values must not contain double quotes or backslashes: they are written into YAML and Ruby config.

# Base domain. Subdomains app., staging., gitlab., registry., grafana. point to this server.
MSP_DOMAIN=CHANGE_ME.example.com
# Admin IPs or CIDRs, space-separated: SSH allowlist (ufw) and Grafana allowlist (Caddy), docs/09 §2.
MSP_ADMIN_IPS="CHANGE_ME"
# Grafana built-in admin password. Read only when the Grafana volume is first created.
MSP_GRAFANA_ADMIN_PASSWORD=CHANGE_ME
# gmaps-db superuser password. Read only when the gmaps-data volume is first created (docs/09 RB-12).
MSP_GMAPS_DB_PASSWORD=CHANGE_ME

# SMTP for Alertmanager and GitLab email. Port 587 with STARTTLS.
MSP_SMTP_HOST=CHANGE_ME
MSP_SMTP_PORT=587
MSP_SMTP_USER=CHANGE_ME
MSP_SMTP_PASSWORD=CHANGE_ME
MSP_SMTP_FROM=CHANGE_ME@example.com

# Alert recipients (docs/09 §1.1): email and the ops Telegram group.
MSP_ALERT_EMAIL_TO=CHANGE_ME@example.com
MSP_ALERT_TELEGRAM_BOT_TOKEN=CHANGE_ME
# Numeric chat ID of the group, e.g. -1001234567890
MSP_ALERT_TELEGRAM_CHAT_ID=CHANGE_ME
