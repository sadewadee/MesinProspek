# .env of the app stacks /opt/msp (production) and /opt/msp-staging (staging): the only list of keys
# (docs/06-ci-cd.md §7). deploy/deploy.sh writes .env from this list on every deploy (mode 600); never edit
# it on the server: change the CI/CD variable and run the deploy job again (docs/09 RB-12).
# Values here are dummies or non-secret defaults. Never commit a real secret (STD-AGENT-06).
#
# How deploy.sh fills each key:
#   value contains CHANGE_ME   required: GitLab CI/CD variable with the same name, environment scope
#                              staging or production (never "All"), Protected, Masked if secret.
#                              The deploy stops and names every missing one.
#   empty value                optional: written only when that CI/CD variable exists.
#   any other value            default: written as is, unless a CI/CD variable with the same name exists.
#   "Set by deploy.sh"         computed by the script.
# Values must not contain single quotes or line breaks.

# --- Set by deploy.sh ----------------------------------------------------------------------------------
# staging | production: network edge-${MSP_ENV} and process config (docs/04 §14).
MSP_ENV=staging
# $CI_REGISTRY_IMAGE and the git SHA being deployed: images <registry>/msp/api and /web:<git-sha>.
MSP_IMAGE_REPO=registry.example.com/msp
MSP_IMAGE_TAG=0123456789abcdef0123456789abcdef01234567
# Staging adds its resource limits (06 §2); production runs compose.yaml alone.
COMPOSE_FILE=compose.yaml:compose.staging.yaml

# --- Process (docs/04 §14) -----------------------------------------------------------------------------
# https://app.<domain> (production) or https://staging.<domain>, no trailing slash. deploy.sh checks
# <url>/readyz after a deploy; msp api accepts state-changing requests only with this Origin (docs/04 §9).
MSP_PUBLIC_URL=https://CHANGE_ME.example.com
# debug | info | warn | error; empty = info.
MSP_LOG_LEVEL=
# Fixed: the healthcheck, deploy/ops/Caddyfile and deploy/ops/prometheus.yml use these ports.
MSP_HTTP_ADDR=:8080
MSP_METRICS_ADDR=:9090
MSP_KRATOS_PUBLIC_URL=http://kratos:4433
MSP_GEOAPI_BASE_URL=https://geoapi.mcpke.dev/api
# Export files; the storage volume is mounted here (docker-compose.prod.yml).
MSP_STORAGE_DIR=/var/lib/msp/storage

# --- Database (docs/04 §4.4) ---------------------------------------------------------------------------
# Superuser of the postgres service. Read only when the pgdata volume is first created.
POSTGRES_PASSWORD=CHANGE_ME
# Runtime role msp_app (api, worker, tool) and schema owner msp_owner (msp migrate only). On the first init
# of the pgdata volume, postgres/init-msp.sh sets both role passwords from these URLs. Percent-encode
# special characters in the password.
MSP_DATABASE_URL=postgres://msp_app:CHANGE_ME@postgres:5432/msp?sslmode=disable
MSP_MIGRATE_DATABASE_URL=postgres://msp_owner:CHANGE_ME@postgres:5432/msp?sslmode=disable
# Latest weekly gmaps drop, read-only (06 §7, 09 RB-15). Same value in both environments:
# postgres://msp_source_ro:<password>@gmaps-db:5432/gmaps?sslmode=disable
# Empty: the daily import is not scheduled and `msp tool import` stops with a message (docs/04 §14).
MSP_SOURCE_DATABASE_URL=

# --- Secrets -------------------------------------------------------------------------------------------
# 32 random bytes, base64 (`openssl rand -base64 32`): key for signed download URLs (docs/04 §13).
MSP_ENCRYPTION_KEY=CHANGE_ME
# API keys only. Provider, model and base URL are ops settings in the database (06 §7, 09 RB-14).
# Optional until WP-23 (AI narrative) uses it; the founder supplies it then (07 §6).
MSP_ANTHROPIC_API_KEY=
MSP_LLM_FALLBACK_API_KEY=
# Member invitation email (docs/04 §14).
MSP_SMTP_URL=smtp://CHANGE_ME:CHANGE_ME@smtp.example.com:587

# --- Kratos (docs/04 §9) -------------------------------------------------------------------------------
# Environment overrides of deploy/kratos/kratos.yml (a key a.b.c is the variable A_B_C). Its public base URL
# is derived from MSP_PUBLIC_URL in docker-compose.prod.yml, so MSP_PUBLIC_URL has no trailing slash.
# Kratos database `kratos` in the same postgres service: on the first init of the pgdata volume,
# postgres/init-msp.sh creates role and database kratos with the password of this URL.
DSN=postgres://kratos:CHANGE_ME@postgres:5432/kratos?sslmode=disable&max_conns=20&max_idle_conns=4
# Comma-separated, at least 16 characters each. Rotation: put the new secret first and keep the old ones
# after it, so sessions survive (docs/09 RB-12).
SECRETS_COOKIE=CHANGE_ME
# Exactly 32 characters (encrypts stored OIDC tokens); same rotation rule.
SECRETS_CIPHER=CHANGE_ME
# Verification and recovery email. Port 465: smtps://; 587: smtp:// (STARTTLS).
COURIER_SMTP_CONNECTION_URI=smtp://CHANGE_ME:CHANGE_ME@smtp.example.com:587
COURIER_SMTP_FROM_ADDRESS=no-reply@CHANGE_ME.example.com
# Google login (WP-15): off while empty. Set both, the second as one JSON line with the OAuth client
# (redirect URI <MSP_PUBLIC_URL>/.ory/self-service/methods/oidc/callback/google):
#   true
#   [{"id":"google","provider":"google","client_id":"<id>","client_secret":"<secret>","mapper_url":"file:///etc/kratos/oidc.google.jsonnet","scope":["email","profile"]}]
SELFSERVICE_METHODS_OIDC_ENABLED=
SELFSERVICE_METHODS_OIDC_CONFIG_PROVIDERS=

# --- pgBackRest, production (06 §8; WAL archiving is switched on once by hand) ---------------------------
# Passphrase of every backup, local and off-site; without it no backup can be restored. Production only;
# keep a copy in the founder's password manager (06 §7).
PGBACKREST_REPO1_CIPHER_PASS=
PGBACKREST_STANZA=msp
PGBACKREST_PG1_PATH=/var/lib/postgresql/data
PGBACKREST_REPO1_PATH=/var/lib/pgbackrest
PGBACKREST_REPO1_CIPHER_TYPE=aes-256-cbc
PGBACKREST_REPO1_RETENTION_FULL=4
